---
// Custom Starlight site title: the SAG Solutions wordmark + the otel-fleet product name.
const base = import.meta.env.BASE_URL;
const href = base.endsWith('/') ? base : base + '/';
---

<a href={href} class="sag-sitetitle" aria-label="otel-fleet — SAG Solutions">
  <span class="sag-mark" aria-hidden="true">S</span>
  <span class="sag-wordmark" aria-hidden="true">
    <span class="sag-wordmark__word">SAG</span>
    <span class="sag-wordmark__sub">SOLUTIONS</span>
  </span>
  <span class="sag-product">otel-fleet</span>
</a>
