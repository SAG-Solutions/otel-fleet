{
  "uid": "otelfleet-cluster",
  "title": "otel-fleet / Kubernetes Cluster",
  "tags": ["otel-fleet", "kubernetes"],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1 }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Cluster CPU (cores)",
      "description": "cluster:node_cpu_usage:sum — total CPU cores in use across nodes (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "cluster:node_cpu_usage:sum", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Cluster memory",
      "description": "cluster:node_memory_usage_bytes:sum — total node memory in use (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "cluster:node_memory_usage_bytes:sum", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Pods (all namespaces)",
      "description": "sum of namespace:pods:count (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(namespace:pods:count)", "range": true, "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Cluster CPU cores in use",
      "description": "cluster:node_cpu_usage:sum over time.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "cluster:node_cpu_usage:sum", "range": true, "refId": "A", "legendFormat": "cores" } ]
    },
    {
      "type": "timeseries",
      "title": "Cluster memory in use",
      "description": "cluster:node_memory_usage_bytes:sum over time.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "cluster:node_memory_usage_bytes:sum", "range": true, "refId": "A", "legendFormat": "bytes" } ]
    },
    {
      "type": "timeseries",
      "title": "Pod CPU by namespace",
      "description": "namespace:pod_cpu_usage:sum — top namespaces by CPU (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "topk(10, namespace:pod_cpu_usage:sum)", "range": true, "refId": "A", "legendFormat": "{{k8s_namespace_name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Pod memory by namespace",
      "description": "namespace:pod_memory_usage_bytes:sum — top namespaces by memory (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "topk(10, namespace:pod_memory_usage_bytes:sum)", "range": true, "refId": "A", "legendFormat": "{{k8s_namespace_name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Node network I/O",
      "description": "node:network_io_bytes:rate5m — per-node network throughput (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "node:network_io_bytes:rate5m", "range": true, "refId": "A", "legendFormat": "{{k8s_node_name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Pods per namespace",
      "description": "namespace:pods:count — pod count per namespace (recording rule).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "namespace:pods:count", "range": true, "refId": "A", "legendFormat": "{{k8s_namespace_name}}" } ]
    }
  ]
}
